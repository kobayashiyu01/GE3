[*.{cpp,h,hlsl,hlsli}]
charset = utf-8

# スペルミスをintellisenseでの「エラー」として使う

spelling_error_severity = error

# チェック対象を「識別子(変数名など)」と「コメント」に限定する

spelling_checkable_types = identifiers,comments

# 辞書を英語(米国)に設定する

spelling_languaes =en-us

# 自分の辞書を作れるように標準の除外辞書設定はそのまま使用

spelling_use_default_exclusion_dictiomary = true

spelling_exclusion_path = ./exclusion.dic

[externals/**]

generated_code = true

